<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F4F7FB">
    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CAR ANIMATION by Prince"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1F2937"
        android:layout_marginBottom="8dp" />
    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select an animation"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="20dp" />
    <!-- Car Image -->
    <ImageView
        android:id="@+id/imgCar"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:src="@drawable/car"
        android:scaleType="fitCenter"
        android:contentDescription="Car"
        android:layout_marginBottom="24dp" />
    <!-- Fade Animation Button -->
    <Button
        android:id="@+id/btnFade"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Fade Animation"
        android:textAllCaps="false" />
    <!-- Rotate Animation Button -->
    <Button
        android:id="@+id/btnRotate"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Rotate Animation"
        android:textAllCaps="false" />
    <!-- Blink Animation Button -->
    <Button
        android:id="@+id/btnBlink"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Blink Animation"
        android:textAllCaps="false" />
    <!-- Move Animation Button -->
    <Button
        android:id="@+id/btnMove"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Move Animation"
        android:textAllCaps="false" />
</LinearLayout>
